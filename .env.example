# API-ключ команды (получите на app.ai-business-spb.ru)
API_KEY=your-team-api-key

# MSSQL (локальный Docker)
MSSQL_SA_PASSWORD=YourStrong!Pass123
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=service_desk_tdbb
MSSQL_USER=SA

# Backend admin API
BACKEND_JWT_SECRET=change-me-in-production
BACKEND_ADMIN_LOGIN=admin
BACKEND_ADMIN_EMAIL=admin@example.com
BACKEND_ADMIN_PASSWORD=admin12345
BACKEND_AI_AGENT_BASE_URL=http://localhost:8090
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
BACKEND_ENABLE_DEV_SEED=false
BACKEND_RUN_MIGRATIONS_ON_STARTUP=false

# Postgres
POSTGRES_DB=baltiyskiy_bereg
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend

# AI agent runtime
AI_AGENT_ENABLE_ORCHESTRATOR=false

# YandexGPT
YANDEX_GPT_API_KEY=your-api-key
YANDEX_GPT_FOLDER_ID=your-folder-id

# Yandex Vision OCR (optional; if empty, extract_datasets can fallback to YandexGPT creds)
YANDEX_OCR_API_KEY=
YANDEX_OCR_FOLDER_ID=
