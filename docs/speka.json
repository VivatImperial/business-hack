        }
      ]
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/settings",
      "_comment": "Сохранить настройки",
      "query": {},
      "body": {
        "tone_of_voice": {
          "type": "string"
        },
        "confidence_threshold": {
          "type": "number",
          "format": "0..1"
        },
        "top_k": {
          "type": "integer"
        },
        "use_articles": {
          "type": "boolean",
          "allowed_values": {
            "true": "Использовать статьи при поиске ответа",
