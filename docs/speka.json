        "appeal_id": {
          "type": "string"
        }
      },
      "query": {},
      "body": null,
      "response": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "fixed_value": "closed"
        },
        "closed_at": {
          "type": "string",
          "format": "datetime"
        }
      },
      "errors": [
        {
          "code": 401,
          "description": "Не авторизован"
        },
        {
          "code": 404,
          "description": "Обращение не найдено"
        }
      ]
    },
    {
