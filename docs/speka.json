      "path_params": {
        "appeal_id": {
          "type": "string"
        }
      },
      "query": {},
      "body": null,
      "response": {
        "id": {
          "type": "string"
        },
        "rating_request_sent": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "code": 400,
          "description": "Запрос рейтинга можно отправить только после закрытия обращения"
        },
        {
          "code": 401,
          "description": "Не авторизован"
        },
        {
          "code": 404,
          "description": "Обращение не найдено"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/settings",
      "_comment": "Вернуть текущие настройки",
      "query": {},
      "body": null,
      "response": {
        "tone_of_voice": {
          "type": "string"
        },
        "confidence_threshold": {
          "type": "number",
          "format": "0..1"
        },
        "top_k": {
          "type": "integer"
        },
        "use_articles": {
          "type": "boolean",
          "allowed_values": {
            "true": "Использовать статьи при поиске ответа",
            "false": "Не использовать статьи при поиске ответа"
          }
        }
      },
      "errors": [
        {
